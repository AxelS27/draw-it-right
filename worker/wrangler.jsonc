{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "draw-it-right-match",
  "account_id": "403f2dc05e335385f92b0881869cb3fa",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "vars": {
    "FIREBASE_PROJECT_ID": "draw-it-right",
    "ALLOWED_ORIGINS": "http://localhost:3000,https://draw-it-right.vercel.app"
  },
  "durable_objects": {
    "bindings": [
      { "name": "MATCHES", "class_name": "MatchRoom" },
      { "name": "WALLETS", "class_name": "PlayerWallet" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MatchRoom", "PlayerWallet"] }]
}
